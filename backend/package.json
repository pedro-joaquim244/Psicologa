{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/scheduling.test.js tests/email.test.js tests/appointment-notifications.test.js tests/limit-auth.test.js tests/postgres-compat.test.js tests/demo-mode.test.js",
    "test:mysql": "node --test tests/*.test.js",
    "test:postgres": "node --trace-deprecation tests/postgres-integration.mjs",
    "check:postgres": "node --trace-deprecation scripts/check-postgres.mjs",
    "migrate": "node scripts/migrate-database.mjs",
    "migrate:mysql": "node src/migrar-pacientes.js && node src/migrar-agenda.js",
    "migrate:postgres": "node scripts/migrate-postgres.mjs",
    "seed:postgres": "node scripts/seed-postgres.mjs",
    "demo:provision": "node scripts/provision-demo.mjs",
    "migrate:agenda": "node src/migrar-agenda.js",
    "dev": "node --watch src/server.js",
    "start:demo": "node scripts/provision-demo.mjs && node src/server.js",
    "start": "node src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.8",
    "pg": "^8.23.1"
  }
}
