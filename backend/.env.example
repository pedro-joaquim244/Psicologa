PORT=3333
# postgres usa DATABASE_URL; sem DATABASE_URL o backend mantem o MySQL legado.
DB_CLIENT=postgres
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/agenda_local
# Produção/Supabase: require (TLS). PostgreSQL local sem TLS: disable.
DATABASE_SSL=disable
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_APPLICATION_NAME=agenda-api

# Configuração MySQL legada, usada somente quando DB_CLIENT=mysql.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=psicologa
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=configure-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173

# Render Free bloqueia SMTP. Em produção, prefira a API HTTPS do Resend.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Nome da profissional <remetente@dominio-verificado.example>"

# Alternativa SMTP para ambiente local/host compatível. 587 usa STARTTLS; 465 usa TLS.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nome da profissional <remetente@example.com>"
# Fila persistente: a API tenta novamente envios que falharam até três vezes.
# NOTIFICATION_RETRY_INTERVAL_MS=300000

# Provisionamento opcional e explícito da demonstração PostgreSQL.
# Use somente endereços reservados @example.invalid e senhas fictícias fortes.
# A execução também exige ALLOW_REMOTE_DEMO_SEED=true; não mantenha essa flag ativa.
# ALLOW_REMOTE_DEMO_SEED=false
# DEMO_PROFESSIONAL_NAME=Profissional Demonstração
# DEMO_PROFESSIONAL_EMAIL=profissional.demo@example.invalid
# DEMO_PROFESSIONAL_PASSWORD=
# DEMO_PATIENT_NAME=Paciente Demonstração
# DEMO_PATIENT_EMAIL=paciente.demo@example.invalid
# DEMO_PATIENT_PASSWORD=

# Rate limiting. In development, auto uses bounded process memory. In Vercel,
# set RATE_LIMIT_STORE=upstash and configure both Upstash credentials below.

# UPSTASH_REDIS_REST_URL=   
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_GLOBAL_MAX=180
# RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_MS=1800000
# RATE_LIMIT_VERIFICATION_MAX=10
# RATE_LIMIT_VERIFICATION_WINDOW_MS=900000
# RATE_LIMIT_RESEND_MAX=5
# RATE_LIMIT_RESEND_WINDOW_MS=900000
# RATE_LIMIT_BOOKING_MAX=20
# RATE_LIMIT_BOOKING_WINDOW_MS=600000
# RATE_LIMIT_WRITE_MAX=60
# RATE_LIMIT_WRITE_WINDOW_MS=60000
# RATE_LIMIT_MEMORY_MAX_ENTRIES=10000
# RATE_LIMIT_LOGS=false # optional: disables the grouped, non-PII 429 logs

# FRONTEND_URL aceita várias origens exatas separadas por vírgula, sem caminhos.
# TRUST_PROXY: somente IPs/sub-redes de proxies confiáveis da infraestrutura.
# TRUST_PROXY=
# Usadas somente por src/criar-admin.js. Não há senha padrão.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
