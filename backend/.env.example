PORT=3333
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=psicologa
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=configure-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173

# Remetente autorizado no provedor SMTP. 587 usa STARTTLS; 465 usa TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nome da profissional <remetente@example.com>"

# Rate limiting. In development, auto uses bounded process memory. In Vercel,
# set RATE_LIMIT_STORE=upstash and configure both Upstash credentials below.

# UPSTASH_REDIS_REST_URL=   
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_GLOBAL_MAX=180
# RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_MS=1800000
# RATE_LIMIT_VERIFICATION_MAX=10
# RATE_LIMIT_VERIFICATION_WINDOW_MS=900000
# RATE_LIMIT_RESEND_MAX=5
# RATE_LIMIT_RESEND_WINDOW_MS=900000
# RATE_LIMIT_BOOKING_MAX=20
# RATE_LIMIT_BOOKING_WINDOW_MS=600000
# RATE_LIMIT_WRITE_MAX=60
# RATE_LIMIT_WRITE_WINDOW_MS=60000
# RATE_LIMIT_MEMORY_MAX_ENTRIES=10000
# RATE_LIMIT_LOGS=false # optional: disables the grouped, non-PII 429 logs

# FRONTEND_URL aceita várias origens exatas separadas por vírgula, sem caminhos.
# TRUST_PROXY: somente IPs/sub-redes de proxies confiáveis da infraestrutura.
# TRUST_PROXY=
# Usadas somente por src/criar-admin.js. Não há senha padrão.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
