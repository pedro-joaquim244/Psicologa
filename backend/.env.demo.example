PORT=3333
NODE_ENV=production
DB_CLIENT=postgres
DATABASE_URL=postgresql://USUARIO:SENHA@HOST_SESSION_POOLER:5432/postgres
DATABASE_SSL=require
DB_POOL_MAX=5
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-bytes
JWT_EXPIRES_IN=8h
FRONTEND_URL=https://SEU-FRONTEND.example
TRUST_PROXY=1
RATE_LIMIT_STORE=memory

# Demonstração pública sem e-mail externo e sem cadastro público.
DEMO_MODE=true
DEMO_AUTO_PROVISION=true
DEMO_PUBLIC_LOGIN=true
PUBLIC_REGISTRATION_ENABLED=false
EMAIL_PROVIDER=disabled

# O provisionador usa e-mails reservados @example.invalid e hashes aleatórios.
# Sobrescreva somente se precisar de outros identificadores também fictícios.
DEMO_PROFESSIONAL_EMAIL=profissional.demo@example.invalid
DEMO_PATIENT_EMAIL=paciente.demo@example.invalid
